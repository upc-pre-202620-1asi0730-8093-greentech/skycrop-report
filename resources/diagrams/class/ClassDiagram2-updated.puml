@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 150
scale max 2200 width
hide empty members
legend bottom
aggregate root: entry point to the aggregate's entities.
external reference: identity of an object from another context.
Dependencies labeled with Id represent references by identifier.
All value objects have no identity and are immutable.
Values are validated on construction; changes create a new value.
Equality compares attributes, except for Timestamp (UTC instant).
CalendarDate represents a valid date without a time or time zone.
endlegend
title SkyCrop - Plots and Drones
class User <<external reference>> {
-id: Long
}
class AgriculturalPlot <<aggregate root>> {
-ownerId: Long
-memberIds: Set<Long>
-id: Long
-name: Name
-areaHectares: Area
-location: Location
-createdAt: Timestamp
-status: PlotStatus
+register(): void
+updateInformation(): void
+defineLimits(): void
+generateMap(): PlotMap
+updateDashboard(): void
}
interface MapService  {

+getLocationInformation(): Location
+generatePlotMap(plot: AgriculturalPlot): PlotMap
}
class Crop  {
-id: Long
-name: Name
-variety: String
-growthStage: String
-registrationDate: CalendarDate
+register(): void
+updateInformation(): void
+assignToPlot(plotId: Long): void
}
class PlotMap  {
-id: Long
-mapUrl: ResourceUrl
-generatedAt: Timestamp
-source: String
+generate(): void
+display(): void
+update(): void
}
class FlightPlan <<aggregate root>> {
-plotId: Long
-id: Long
-name: Name
-altitude: Altitude
-speed: Speed
-overlap: Percentage
-status: FlightPlanStatus
+createRoute(): void
+customizeRoute(): void
+validateRoute(): boolean
}
class Drone <<aggregate root>> {
-ownerId: Long
-id: Long
-serialNumber: DroneSerialNumber
-model: Name
-batteryLevel: Percentage
-range: Distance
-status: DroneStatus
+register(): void
+configure(): void
+checkBattery(): Percentage
+startFlight(): void
+stopFlight(): void
}
interface DroneController  {

+connect(drone: Drone): boolean
+configure(drone: Drone): void
+uploadFlightPlan(plan: FlightPlan): void
+startFlight(flight: Flight): void
+stopFlight(flight: Flight): void
}
class DroneConfiguration  {
-id: Long
-connectionSettings: ConnectionSettings
-flightSettings: FlightParameters
-securitySettings: SecuritySettings
+configure(): void
+updateSettings(): void
+applyToDrone(droneId: Long): void
}
class Flight <<aggregate root>> {
-flightPlanId: Long
-droneId: Long
-id: Long
-startTime: Timestamp [0..1]
-endTime: Timestamp [0..1]
-status: FlightStatus
+start(): void
+pause(): void
+finish(): void
+cancel(): void
+captureImage(): AerialImage
}
class AerialImage  {
-id: Long
-capturedAt: Timestamp
-resolution: ImageResolution
-fileUrl: ResourceUrl
-quality: ImageQuality
+capture(): void
+upload(): void
+validateQuality(): boolean
}
interface CloudStorageService  {

+upload(file: AerialImage): ResourceUrl
+download(url: ResourceUrl): AerialImage
}
enum PlotStatus {
ACTIVE
INACTIVE
}
enum FlightPlanStatus {
DRAFT
READY
ACTIVE
COMPLETED
}
enum DroneStatus {
AVAILABLE
IN_FLIGHT
LOW_BATTERY
OFFLINE
MAINTENANCE
}
enum FlightStatus {
PLANNED
IN_PROGRESS
PAUSED
COMPLETED
CANCELLED
}
enum ImageQuality {
LOW
MEDIUM
HIGH
}
class Location <<value object>> {
-value: String {readOnly}

}
class Area <<value object>> {
-value: Decimal {readOnly}
-unit: String = "ha" {readOnly}

}
AgriculturalPlot ..> User : ownerId / memberIds
Drone ..> User : ownerId
AgriculturalPlot "1" *-- "1" Area : areaHectares
AgriculturalPlot "1" *-- "1" Location : location
AgriculturalPlot --> PlotStatus : status
AgriculturalPlot "1" *-- "0..*" Crop : contains
AgriculturalPlot "1" *-- "0..1" PlotMap : has
FlightPlan ..> AgriculturalPlot : plotId
MapService ..> AgriculturalPlot : obtains location
MapService ..> PlotMap : generates
MapService ..> Location
FlightPlan --> FlightPlanStatus : status
Flight ..> FlightPlan : flightPlanId
Flight ..> Drone : droneId
Drone "1" *-- "1" DroneConfiguration : uses
Drone --> DroneStatus : status
DroneController ..> FlightPlan : uploads
DroneController ..> Flight : controls
DroneController ..> Drone : controls
DroneController ..> DroneConfiguration : configures
Flight --> FlightStatus : status
Flight "1" *-- "0..*" AerialImage : captures
CloudStorageService ..> AerialImage : stores
AerialImage --> ImageQuality : quality
note bottom of Area
Immutable; unit fixed to hectares.
Equality compares values; there is no identity.
end note
class Name <<value object>> {
-value: String {readOnly}
}
note right of Name
Non-empty text after trimming outer whitespace.
Preserves the name's characters and original case.
Does not require a specific word count.
end note
class Timestamp <<value object>> {
-value: DateTimeOffset {readOnly}
}
note right of Timestamp
Valid instant with an explicit time zone offset.
Equality and ordering compare the UTC instant.
end note
AgriculturalPlot "1" *-- "1" Name : name
Crop "1" *-- "1" Name : name
FlightPlan "1" *-- "1" Name : name
AgriculturalPlot ..> Timestamp : temporal values
PlotMap ..> Timestamp : temporal values
Flight ..> Timestamp : temporal values
AerialImage ..> Timestamp : temporal values
class CalendarDate <<value object>> {
-value: Date {readOnly}
}
Crop "1" *-- "1" CalendarDate : registrationDate
note bottom of Flight
startTime is absent before the flight starts.
endTime is absent before the flight ends.
When both exist, endTime >= startTime.
end note
class Altitude <<value object>> {
-meters: Decimal {readOnly}
}
note right of Altitude
Non-negative height in meters above the flight reference.
Equality compares meters.
Permitted operating limits are checked by the flight policy.
end note
class Speed <<value object>> {
-metersPerSecond: Decimal {readOnly}
}
note right of Speed
Positive flight speed in meters per second.
Equality compares metersPerSecond.
Device-specific limits are checked by the flight policy.
end note
class Distance <<value object>> {
-meters: Decimal {readOnly}
}
note right of Distance
Non-negative distance in meters.
Equality compares meters.
end note
class Percentage <<value object>> {
-value: Decimal {readOnly}
}
note right of Percentage
Value in [0, 100], expressed as a percentage.
Equality compares the numeric value.
Minimum battery and flight overlap policies are defined separately.
end note
class DroneSerialNumber <<value object>> {
-value: String {readOnly}
}
note right of DroneSerialNumber
Non-empty text after trimming outer whitespace.
Preserves case; equality compares the stored value.
Uniqueness is checked by the registration use case.
end note
class ImageResolution <<value object>> {
-widthPixels: Integer {readOnly}
-heightPixels: Integer {readOnly}
}
note right of ImageResolution
Both dimensions are positive integers in pixels.
Equality compares width and height in that order.
end note
class ResourceUrl <<value object>> {
-value: String {readOnly}
}
note right of ResourceUrl
Absolute HTTP or HTTPS URL with a host.
Equality uses the complete stored URL, including path and query.
A valid URL does not guarantee availability or access permission.
end note
FlightPlan "1" *-- "1" Altitude : altitude
FlightPlan "1" *-- "1" Speed : speed
FlightPlan "1" *-- "1" Percentage : overlap
Drone "1" *-- "1" Percentage : batteryLevel
Drone "1" *-- "1" Distance : range
Drone "1" *-- "1" DroneSerialNumber : serialNumber
AerialImage "1" *-- "1" ImageResolution : resolution
AerialImage "1" *-- "1" ResourceUrl : fileUrl
PlotMap "1" *-- "1" ResourceUrl : mapUrl
CloudStorageService ..> ResourceUrl : file location
class FlightParameters <<value object>> {
-altitude: Altitude {readOnly}
-speed: Speed {readOnly}
}
note right of FlightParameters
Positive altitude in meters and speed in meters per second.
Device limits are checked by the flight planning policy.
Equality compares altitude and speed; updates replace both values.
end note
class ConnectionSettings <<value object>> {
-endpoint: String {readOnly}
-protocol: String {readOnly}
}
note right of ConnectionSettings
Non-empty absolute endpoint and a supported protocol.
The device adapter validates protocol and endpoint compatibility.
Equality compares both values; credentials are not embedded.
end note
class SecuritySettings <<value object>> {
-requiresAuthentication: boolean {readOnly}
-requiresEncryptedTransport: boolean {readOnly}
}
note right of SecuritySettings
Explicit device authentication and transport requirements.
The connection policy rejects unsupported combinations.
Stores no password or secret; equality compares both flags.
end note
Drone "1" *-- "1" Name : model
DroneConfiguration "1" *-- "1" ConnectionSettings : connectionSettings
DroneConfiguration "1" *-- "1" FlightParameters : flightSettings
DroneConfiguration "1" *-- "1" SecuritySettings : securitySettings
FlightParameters "1" *-- "1" Altitude : altitude
FlightParameters "1" *-- "1" Speed : speed
@enduml
