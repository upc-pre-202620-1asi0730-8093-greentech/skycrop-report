@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 220
skinparam nodesep 35
skinparam ranksep 50
top to bottom direction
title SkyCrop - C4 - Frontend Components by Layer
actor "Farmer / Agronomist" as user
rectangle "Frontend Web Application\n[Container: Vue / JavaScript / PrimeVue]" {
rectangle "Presentation" {
component "Shared Layout and Router\n[Vue / Vue Router]\n\nNavigation, language selection and page composition." as layout
component "Core Views\n[Vue / PrimeVue]\n\nDiagnoses Generation and Report Management." as coreViews
component "Supporting Views\n[Vue / PrimeVue]\n\nAgricultural Plot Management (including Crops), Drone Management,\nSubscriptions and Payment Management, Profiles and Preferences Management." as supportingViews
component "Generic Views\n[Vue / PrimeVue]\n\nNotification Service and IAM - Identity and Access Management." as genericViews
}
rectangle "Application" {
component "Core Stores\n[Pinia / JavaScript]\n\nCoordinate diagnosis and report actions and state." as coreStores
component "Supporting Stores\n[Pinia / JavaScript]\n\nCoordinate plot, crop, drone, subscription and profile actions and state." as supportingStores
component "Generic Stores\n[Pinia / JavaScript]\n\nCoordinate notifications and identity session actions and state." as genericStores
}
rectangle "Domain" {
component "Core Client Models\n[JavaScript]\n\nDiagnosis and report entities, value objects and validation." as coreModels
component "Supporting Client Models\n[JavaScript]\n\nPlot, crop, drone and subscription models and validation." as supportingModels
component "Generic Client Models\n[JavaScript]\n\nIdentity values and notification navigation rules." as genericModels
}
rectangle "Infrastructure" {
component "Context API Clients\n[Axios / JavaScript]\n\nRead and write HTTP resources through the configured API." as clients
component "Context Assemblers\n[JavaScript]\n\nMap transport resources to client models and back." as assemblers
component "Shared HTTP Client\n[Axios / JavaScript]\n\nBase URL, headers and HTTP transport." as http
component "Map Adapter\n[Leaflet / JavaScript]\n\nMap tiles and geocoding requests." as mapsAdapter
}
}
component "RESTful API\n[External container: ASP.NET Core]\n\nTarget backend contracts; the current client uses the mock API." as api
component "Map Providers\n[External systems]\n\nMap tiles and geocoding." as maps
user --> layout : Interacts
layout --> coreViews : Displays
layout --> supportingViews : Displays
layout --> genericViews : Displays
coreViews --> coreStores : Requests actions / reads state
supportingViews --> supportingStores : Requests actions / reads state
genericViews --> genericStores : Requests actions / reads state
coreStores --> coreModels : Applies client validation
supportingStores --> supportingModels : Applies client validation
genericStores --> genericModels : Applies client validation
coreStores --> clients : Invokes remote operations
supportingStores --> clients : Invokes remote operations
genericStores --> clients : Invokes remote operations
coreStores --> assemblers : Maps resources
supportingStores --> assemblers : Maps resources
assemblers --> coreModels : Constructs models
assemblers --> supportingModels : Constructs models
clients --> http : Sends requests
http --> api : HTTPS / JSON
supportingViews --> mapsAdapter : Displays plot locations
coreViews --> mapsAdapter : Displays diagnosis locations
mapsAdapter --> maps : HTTPS / tiles
coreViews -[hidden]right-> supportingViews
supportingViews -[hidden]right-> genericViews
coreStores -[hidden]right-> supportingStores
supportingStores -[hidden]right-> genericStores
coreModels -[hidden]right-> supportingModels
supportingModels -[hidden]right-> genericModels
coreModels -[hidden]down-> clients
legend bottom
Component overview of one frontend container, grouped by layer.
Context groups follow the core, supporting and generic domain catalog.
Crops belong to Agricultural Plot Management; Shared is not a bounded context.
Dependencies point from a consumer to the component it uses.
Client models do not depend on HTTP transport or replace backend domain rules.
The target architecture includes the backend API; the current deployment uses a mock API.
Individual context diagrams expand these component groups.
endlegend
@enduml
