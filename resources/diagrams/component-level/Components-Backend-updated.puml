@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName SansSerif
skinparam wrapWidth 220
left to right direction

title SkyCrop - C4 - Backend Component Overview

Container(spa, "Single Page Application", "Vue, JavaScript, PrimeVue", "It runs in the browser and manages the interaction between farmers and agronomists.")

ContainerDb(db, "Relational Database", "MySQL Server", "Stores application data.")

Container_Boundary(api, "Backend RESTful API") {



Component(shared, "Shared",                  "C#, ASP.NET", "Shares base abstractions, error handlers, localization.")
Component(diagnoses, "Diagnoses",            "C#, ASP.NET", "Requests analysis and stores diagnoses and anomalies.")
Component(reports, "Reports",                "C#, ASP.NET", "Consolidates diagnoses and generates documents.")
Component(plots, "Plots",                    "C#, ASP.NET", "Manages plots and collaborative access.")
Component(crops, "Crops",                    "C#, ASP.NET", "Manages crops and their details")
Component(drones, "Drones",                  "C#, ASP.NET", "Manages devices, flight plans and flight executions.")
Component(subscriptions, "Subscriptions",    "C#, ASP.NET", "Manages subscription validity and transactions.")
Component(profiles, "Profiles",              "C#, ASP.NET", "Manages user contact information.")
Component(notifications, "Notifications",    "C#, ASP.NET", "Records notifications and coordinates delivery.")
Component(iam, "IAM",                        "C#, ASP.NET", "Manages identities, credentials and authorization.")

}


Rel(crops, plots, "Gets plot information")
Rel(diagnoses, plots, "Gets plot information")

Rel(subscriptions, profiles, "Gets user information")
Rel(notifications, profiles, "Sends notifications")
Rel(iam, profiles, "Gets user information")

Rel(diagnoses, notifications, "Requests alerts")
Rel(reports, notifications, "Requests notifications")
Rel(drones, notifications, "Requests alerts")

Rel(diagnoses,     db,    "Reads and writes diagnoses data")
Rel(reports,       db,    "Reads and writes reports details")
Rel(plots,         db,    "Reads and writes plot information")
Rel(crops,         db,    "Reads and writes crop data")
Rel(drones,        db,    "Reads and writes drone information")
Rel(subscriptions, db,    "Reads and writes subscription details")
Rel(profiles,      db,    "Reads and writes profiles information")
Rel(notifications, db,    "Reads and writes notification details")
Rel(iam,           db,    "Reads and writes IAM details")

Rel(diagnoses,     shared,    "Uses shared abstractions and utilities")
Rel(reports,       shared,    "Uses shared abstractions and utilities")
Rel(plots,         shared,    "Uses shared abstractions and utilities")
Rel(crops,         shared,    "Uses shared abstractions and utilities")
Rel(drones,        shared,    "Uses shared abstractions and utilities")
Rel(subscriptions, shared,    "Uses shared abstractions and utilities")
Rel(profiles,      shared,    "Uses shared abstractions and utilities")
Rel(notifications, shared,    "Uses shared abstractions and utilities")
Rel(iam,           shared,    "Uses shared abstractions and utilities")

Rel(spa, diagnoses,         "Requests diagnoses details")
Rel(spa, reports,           "Requests reports information")
Rel(spa, plots,             "Creates and views plots")
Rel(spa, crops,             "Creates and views crop details")
Rel(spa, drones,            "Creates and views drones")
Rel(spa, subscriptions,     "Requests subscription plans and details")
Rel(spa, profiles,          "Creates and views profiles")
Rel(spa, notifications,     "Receives notifications")
Rel(spa, iam,               "Signs in and Signs up")





@enduml