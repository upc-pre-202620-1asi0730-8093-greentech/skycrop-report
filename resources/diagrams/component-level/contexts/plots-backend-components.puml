@startuml
' C4 palette: people, systems, containers, components and external systems.
skinparam monochrome false
skinparam backgroundColor #ffffff
skinparam actorStyle rectangle
skinparam actor {
  BackgroundColor #08427b
  BorderColor #08427b
  FontColor #ffffff
}
skinparam component {
  BackgroundColor #85bbf0
  BorderColor #5b8bb1
  FontColor #000000
  BackgroundColor<<container>> #438dd5
  BorderColor<<container>> #2e6295
  FontColor<<container>> #ffffff
  BackgroundColor<<external>> #999999
  BorderColor<<external>> #777777
  FontColor<<external>> #ffffff
  BackgroundColor<<system>> #1168bd
  BorderColor<<system>> #0b4884
  FontColor<<system>> #ffffff
}
skinparam database {
  BackgroundColor #438dd5
  BorderColor #2e6295
  FontColor #ffffff
}
skinparam rectangle {
  BackgroundColor #ffffff
  BorderColor #777777
  FontColor #000000
}
skinparam ArrowColor #555555
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Agricultural Plot Management - backend
component "Frontend Web Application\n[Container: Vue]\n\nRequests context operations." as web <<container>>
rectangle "Backend RESTful API\n[Container: C# / ASP.NET Core]" {
rectangle "Agricultural Plot Management" {
rectangle "Interfaces / Presentation" {
component "AgriculturalPlotController / Interfaces\n[Component: ASP.NET Core]\n\nReceives requests, builds commands and returns resources." as controller
}
rectangle "Application" {
component "AgriculturalPlotApplicationService / Application\n[Component: C#]\n\nManages plots, crops and collaborative access." as service
component "IPlotMapProvider\n[Component: C# interface]\n\nIntegration contract used by the use case." as integrationContract
}
rectangle "Domain" {
component "Domain Model\n[Component: C#]\n\nAggregates, entities, value objects and context rules." as domain
component "Repository Contracts\n[Component: C# interfaces]\n\nDefine aggregate persistence without depending on EF Core." as repositoryContract
}
rectangle "Infrastructure" {
component "Repositories / Infrastructure\n[Component: Entity Framework Core]\n\nImplement aggregate persistence contracts." as repository
component "PlotMapAdapter / Infrastructure\n[Component: C#]\n\nGeographic representation." as adapter
}
}
}
database "Relational Database\n[Container: MySQL Server or PostgreSQL]" as db
web --> controller : REST [HTTPS / JSON]
controller --> service : Delegates operations
service --> domain : Applies rules
service --> repositoryContract : Queries and persists through a contract
repository ..|> repositoryContract : Implements
repository --> domain : Reconstructs aggregates
repository --> db : Reads and writes [EF Core / SQL]
service --> integrationContract : Requests an operation
adapter ..|> integrationContract : Implements
component "Map Service\n[External system: Service]\n\nGeographic representation." as provider <<external>>
adapter --> provider : HTTPS
legend bottom
C4 - Component view of the proposed architecture.
Each view expands a single container.
Contexts group responsibilities within the container.
Solid arrows indicate usage; dashed arrows with a triangle indicate implementation.
Application uses internal contracts; Infrastructure implements them.
endlegend
@enduml
