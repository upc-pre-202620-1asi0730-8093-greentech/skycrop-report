@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Diagnoses Generation - frontend
actor "Farmer / Agronomist\n[Person]" as user
rectangle "Frontend Web Application\n[Container: Vue / JavaScript / PrimeVue]" {
rectangle "Diagnoses Generation" {
rectangle "Presentation" {
component "diagnosis-list\n[Component: Vue / PrimeVue]\n\nDiagnoses, results map and history." as view0
component "diagnosis-details\n[Component: Vue / PrimeVue]\n\nView interaction and data." as view1
component "diagnosis-map\n[Component: Vue / PrimeVue]\n\nView interaction and data." as view2
}
rectangle "Application" {
component "Diagnosis Store\n[Component: Pinia / JavaScript]\n\nCoordinates context actions, data, loading and errors." as state
}
rectangle "Domain" {
component "Context Models\n[Component: JavaScript]\n\nRepresent client data independently of HTTP transport." as model
}
rectangle "Infrastructure" {
component "Diagnosis API Client\n[Component: JavaScript]\n\nExposes the context's remote operations." as apiclient
component "Diagnosis Assembler\n[Component: JavaScript]\n\nTransforms HTTP resources into application models." as assembler
}
}
rectangle "Shared Infrastructure" {
component "Shared HTTP Client\n[Component: JavaScript]\n\nBase URL and HTTP response handling." as http
}
}
component "Backend RESTful API\n[Container: C# / ASP.NET Core]\n\nExposes the context's API contracts." as api
user --> view0 : Interacts
view0 --> state : Reads state / requests actions
user --> view1 : Interacts
view1 --> state : Reads state / requests actions
user --> view2 : Interacts
view2 --> state : Reads state / requests actions
state --> apiclient : Invokes operations
state --> model : Manages client data
assembler --> model : Builds models
state --> assembler : Maps request / response resources
apiclient --> http : Sends requests
http --> api : REST [HTTPS / JSON]
legend bottom
C4 - Component view of the proposed architecture.
Each view expands a single container.
Contexts group responsibilities within the container.
Client models do not replace the backend domain model.
endlegend
@enduml
