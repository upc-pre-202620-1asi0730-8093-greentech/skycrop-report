@startuml
' C4 palette: people, systems, containers, components and external systems.
skinparam monochrome false
skinparam backgroundColor #ffffff
skinparam actorStyle rectangle
skinparam actor {
  BackgroundColor #08427b
  BorderColor #08427b
  FontColor #ffffff
}
skinparam component {
  BackgroundColor #85bbf0
  BorderColor #5b8bb1
  FontColor #000000
  BackgroundColor<<container>> #438dd5
  BorderColor<<container>> #2e6295
  FontColor<<container>> #ffffff
  BackgroundColor<<external>> #999999
  BorderColor<<external>> #777777
  FontColor<<external>> #ffffff
  BackgroundColor<<system>> #1168bd
  BorderColor<<system>> #0b4884
  FontColor<<system>> #ffffff
}
skinparam database {
  BackgroundColor #438dd5
  BorderColor #2e6295
  FontColor #ffffff
}
skinparam rectangle {
  BackgroundColor<<person>> #08427b
  BorderColor<<person>> #08427b
  FontColor<<person>> #ffffff
  BackgroundColor #ffffff
  BorderColor #777777
  FontColor #000000
}
skinparam ArrowColor #555555
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - IAM — Identity and Access Management - frontend
rectangle "Farmer / Agronomist\n[Person]" as user <<person>>
rectangle "Frontend Web Application\n[Container: Vue / JavaScript / PrimeVue]" {
rectangle "IAM — Identity and Access Management" {
rectangle "Presentation" {
component "sign-up\n[Component: Vue / PrimeVue]\n\nRegistration, sign-in and account recovery." as view0
component "sign-in\n[Component: Vue / PrimeVue]\n\nView interaction and data." as view1
component "account-recovery\n[Component: Vue / PrimeVue]\n\nView interaction and data." as view2
}
rectangle "Application" {
component "Account Store\n[Component: Pinia / JavaScript]\n\nCoordinates context actions, data, loading and errors." as state
}
rectangle "Domain" {
component "Context Models\n[Component: JavaScript]\n\nRepresent client data independently of HTTP transport." as model
}
rectangle "Infrastructure" {
component "Account API Client\n[Component: JavaScript]\n\nExposes the context's remote operations." as apiclient
component "Account Assembler\n[Component: JavaScript]\n\nTransforms HTTP resources into application models." as assembler
}
}
rectangle "Shared Infrastructure" {
component "Shared HTTP Client\n[Component: JavaScript]\n\nBase URL and HTTP response handling." as http
}
}
component "Backend RESTful API\n[Container: C# / ASP.NET Core]\n\nExposes the context's API contracts." as api <<container>>
user --> view0 : Interacts
view0 --> state : Reads state / requests actions
user --> view1 : Interacts
view1 --> state : Reads state / requests actions
user --> view2 : Interacts
view2 --> state : Reads state / requests actions
state --> apiclient : Invokes operations
state --> model : Manages client data
assembler --> model : Builds models
state --> assembler : Maps request / response resources
apiclient --> http : Sends requests
http --> api : REST [HTTPS / JSON]
legend bottom
C4 - Component view of the proposed architecture.
Each view expands a single container.
Contexts group responsibilities within the container.
Client models do not replace the backend domain model.
endlegend
@enduml
